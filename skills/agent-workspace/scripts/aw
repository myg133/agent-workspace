#!/usr/bin/env sh
# POSIX launcher for aw.py（Linux / macOS）
# 用法：./aw verify  或把所在目录加入 PATH 后：aw verify
set -eu
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if command -v python3 >/dev/null 2>&1; then
  PY=python3
elif command -v python >/dev/null 2>&1; then
  PY=python
else
  echo "找不到 python3 / python" >&2
  exit 127
fi
exec "$PY" "$DIR/aw.py" "$@"
